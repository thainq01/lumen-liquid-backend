# ============================================================
# LumenLiquid Backend — Production Environment Template
# ============================================================
# Copy this to .env on the production server and fill in values.
#
# NOTE: DATABASE_URL and REDIS_URL use *service names* (not localhost)
# because services connect within the Docker bridge network.
# ============================================================

# ── Docker Compose ──────────────────────────────────────────
DOMAIN=services.lumenliquid.xyz
IMAGE_TAG=latest

# ── Soroban ─────────────────────────────────────────────────
# Primary RPC. Backup is tried automatically on network error / 5xx / 429.
SOROBAN_RPC_URL=https://nameless-side-glitter.stellar-testnet.quiknode.pro/ece5c0bd0b80c64ebd9375e1297438fdbc6485c8/
SOROBAN_RPC_BACKUP_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

PM_CONTRACT_ID=
VAULT_CONTRACT_ID=
REGISTRY_CONTRACT_ID=
ORACLE_CONTRACT_ID=CCYOZJCOPG34LLQQ7N24YXBM7LL62R7ONMZ3G6WZAAYPB5OYKOMJRN63

# ── Database (service name, not localhost) ──────────────────
DATABASE_URL=postgres://lumen:lumen@postgres:5432/lumenliquid?sslmode=disable

# ── Redis (service name, not localhost) ─────────────────────
REDIS_URL=redis://redis:6379/0

# ── Indexer ─────────────────────────────────────────────────
INDEXER_POLL_INTERVAL=2s
INDEXER_START_LEDGER=0

# ── Pair indexer (public address for read-only contract invokes) ──
STELLAR_SOURCE_ACCOUNT=

# ── Keeper ──────────────────────────────────────────────────
KEEPER_SECRET=
KEEPER_POLL_INTERVAL=3s
KEEPER_MAX_RETRIES=20

# ── Market data ─────────────────────────────────────────────
BINANCE_WS_URL=wss://fstream.binance.com/market/ws
PAIR_SYMBOL_MAP=BTCUSDT:0,ETHUSDT:1,SOLUSDT:2,BNBUSDT:3

# ── Misc ────────────────────────────────────────────────────
LOG_LEVEL=info
HTTP_ADDR=:8080
