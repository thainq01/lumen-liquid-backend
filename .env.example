# ── Soroban ────────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Contract IDs (from your testnet deploy — replace before running)
PM_CONTRACT_ID=CA5KQQUTGQTQZBE22QVUH7S4DNTIJSZ7KLTCOEACTRRHMQBH4HVMBXAZ
VAULT_CONTRACT_ID=
REGISTRY_CONTRACT_ID=
ORACLE_CONTRACT_ID=CCYOZJCOPG34LLQQ7N24YXBM7LL62R7ONMZ3G6WZAAYPB5OYKOMJRN63

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgres://lumen:lumen@localhost:5432/lumenliquid?sslmode=disable

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Indexer ────────────────────────────────────────────────
# INDEXER_START_LEDGER: 0 = "use latest at first run"
INDEXER_POLL_INTERVAL=2s
INDEXER_START_LEDGER=0

# ── Misc ───────────────────────────────────────────────────
LOG_LEVEL=info
HTTP_ADDR=:8080

# ── Keeper ─────────────────────────────────────────────────
# Secret key of the funded keeper account (SA...)
KEEPER_SECRET=
# How often the executor retries pending simulations
KEEPER_POLL_INTERVAL=3s
# Max simulation retries before dropping a pending trade
KEEPER_MAX_RETRIES=20
# Binance Futures WS endpoint
BINANCE_WS_URL=wss://fstream.binance.com/market/ws
# Map Binance symbols to on-chain pair indices: SYMBOL:INDEX,...
PAIR_SYMBOL_MAP=BTCUSDT:0,ETHUSDT:1,SOLUSDT:2,BNBUSDT:3
